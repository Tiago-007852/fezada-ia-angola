# Copia para .env (local) e preenche. Na Vercel define os mesmos nomes em
# Project → Settings → Environment Variables (Production + Preview).
# Os valores VITE_* são embutidos no bundle no build; os restantes são só servidor.

# --- Supabase (projeto próprio) ---
# URL do projeto: https://<ref>.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) ou, em projetos antigos, a anon key.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Referência do projeto (aparece na URL). Usada apenas como identificador público.
VITE_SUPABASE_PROJECT_ID=

# --- Apenas servidor (NUNCA com prefixo VITE_) ---
# Secret key (sb_secret_...) ou a service_role key antiga. Bypassa RLS:
# criação/liquidação de bilhetes e operações de admin.
SUPABASE_SERVICE_ROLE_KEY=
# Resultados, odds e fixtures (API-Sports).
API_SPORTS_KEY=
# IA — endpoint OpenAI-compatible.
# Por omissão usa o gateway do Lovable; para um provider próprio (OpenAI, OpenRouter…)
# define AI_GATEWAY_URL e AI_MODEL.
AI_API_KEY=
# AI_GATEWAY_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Protege POST /api/tickets/settle quando chamado pelo agendador (GitHub Actions).
# Na Vercel, define também o mesmo valor no repositório GitHub (Actions → Secrets).
CRON_SECRET=

# --- Configuração pública da subscrição (opcional; há valores por omissão) ---
VITE_SUBSCRIPTION_PRICE=5.000 Kz/mês
VITE_PAYMENT_NUMBER=950 596 073
VITE_ADMIN_WHATSAPP=+244 950 596 073
VITE_ADMIN_WHATSAPP_LINK=https://wa.me/244950596073

# --- Compatibilidade com instalações antigas (Lovable) ---
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=
