# Copia para .env (local) e preenche. No Lovable/produção define estes valores nos Secrets.

# --- Supabase (cliente + servidor) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Apenas servidor (NUNCA com prefixo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=      # liquidação e criação de bilhetes (bypass RLS)
API_SPORTS_KEY=                 # resultados, odds e fixtures (API-Sports)
LOVABLE_API_KEY=                # gateway de IA
LOVABLE_CRON_SECRET=            # protege POST /api/tickets/settle quando chamado pelo agendador

# --- Configuração pública da subscrição (opcional; há valores por omissão) ---
VITE_SUBSCRIPTION_PRICE=5.000 Kz/mês
VITE_PAYMENT_NUMBER=950 596 073
VITE_ADMIN_WHATSAPP=+244 950 596 073
VITE_ADMIN_WHATSAPP_LINK=https://wa.me/244950596073
